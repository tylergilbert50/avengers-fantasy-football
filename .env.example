# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value here.

# ---------- ESPN (see docs/espn.md) ----------

# The number in your league URL:
# https://fantasy.espn.com/football/league?leagueId=123456
ESPN_LEAGUE_ID=

# Defaults to the current NFL season when blank.
ESPN_SEASON=

# Only needed for a private league. These two cookies are your ESPN login —
# they expire roughly annually, at which point /api/league starts 401ing.
ESPN_S2=
ESPN_SWID=

# ---------- Managers' poll (see docs/poll.md) ----------

# Supabase project URL and the *service_role* key, not the anon key. Server-side
# only: it bypasses row-level security and must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Voter addresses are stored as a salted hash. Generate once and keep it:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POLL_IP_SALT=

# Optional. The zone the Tuesday-to-Thursday window is measured in, and how many
# ballots one network may cast in a week (0 turns the address check off).
POLL_TIMEZONE=America/Chicago
POLL_MAX_VOTES_PER_IP=1
